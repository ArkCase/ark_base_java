#
# Members of ${ACM_GROUP} may run set-java as root. The caller's environment
# is reset (sudo's default behavior), the PATH is fixed, and only the variables
# that set-java consumes are passed through. All of these settings apply only
# to running set-java through this rule, and to nothing else.
#
Cmnd_Alias SET_JAVA = /usr/local/bin/set-java

Defaults!SET_JAVA secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# The version to select, when none is given on the command line
Defaults!SET_JAVA env_keep += "ALT_JAVA"

# Everything else (consumed by /.functions)
Defaults!SET_JAVA env_keep += "DEBUG_FUNCTIONS"
Defaults!SET_JAVA env_keep += "NO_COLOR"

%${ACM_GROUP}	ALL=(root) NOPASSWD: SET_JAVA
